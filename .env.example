# Atlas — environment variables

# Required to enable the "Ask Atlas" AI assistant (server-side only — never
# exposed to the browser). Get a key from https://console.anthropic.com.
# Locally: copy this file to .env.local and fill it in.
# On Vercel: Project → Settings → Environment Variables → add ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=

# The assistant uses claude-opus-4-8 by default (set in app/api/atlas/route.ts).
# Without a key set, the platform still runs — the assistant returns a setup
# notice instead of live answers.
